# ═══════════════════════════════════════════════════════════════
#  AETHER Backend — Environment Variables (100% FREE tier)
#  Copy to .env and fill in your keys
# ═══════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Supabase (free tier — supabase.com → Settings → API) ────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key-keep-secret

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Redis (local Docker — free) ──────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI: Google Gemini (free — aistudio.google.com/apikey) ───
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# ── AI: HuggingFace (free — huggingface.co/settings/tokens) ─
# Used for embeddings (pgvector search) + sentiment fallback
HUGGINGFACE_API_KEY=your-hf-token
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Python AI microservice ───────────────────────────────────
PYTHON_AI_URL=http://localhost:8000
PYTHON_AI_SECRET=change-me-shared-secret

# ── NSE data (direct scraping is free; RapidAPI optional) ───
NSE_RAPIDAPI_KEY=
NSE_RAPIDAPI_HOST=latest-stock-price.p.rapidapi.com

# ── Pulse Studio (DISABLED — paid social video skipped) ─────
# Leave empty. Engine will only generate captions, not post.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
YOUTUBE_API_KEY=
